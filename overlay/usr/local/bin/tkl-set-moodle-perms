#!/bin/bash
# ========================================================
# Moodle Permissions Manager - Unified Script
# Branch independent: the permission model is the same for Moodle 4.x and 5.x
# ========================================================

# SCRIPT RELEASE INFORMATION
SCRIPT_RELEASE="26.09"
SCRIPT_AUTHOR="Daniele Lolli (UncleDan)"
SCRIPT_LICENSE="GPL-3.0"

# Exit codes
readonly EXIT_OK=0
readonly EXIT_INVALID_ARGS=1
readonly EXIT_NOT_ROOT=2
readonly EXIT_DIR_NOT_FOUND=3
readonly EXIT_UNKNOWN_VERSION=4   # reserved, no longer used (no branch selection)
readonly EXIT_CHMOD_FAILED=5
readonly EXIT_CHOWN_FAILED=6
readonly EXIT_MKDIR_FAILED=7   # reserved, no longer used (no pre-creation)
readonly EXIT_CACHE_FAILED=8
readonly EXIT_CONFIG_NOT_FOUND=9
readonly EXIT_DATAROOT_NOT_FOUND=10

# --------------------------------------------------------
# DEFAULT CONFIGURATION
# Edit these to match your environment so the script can
# be launched with --fix only (no extra arguments needed).
# --------------------------------------------------------
MOODLE_DIR="/var/www/moodle"         # Moodle installation path
MOODLEDATA_DIR="/var/moodledata"     # moodledata path

# Provenance of the two paths: "default", "argument" or "config.php".
# Paths not passed on the command line are read from config.php.
MOODLE_DIR_SOURCE="default"
MOODLEDATA_DIR_SOURCE="default"
MOODLE_DIR_FROM_ARG=false
MOODLEDATA_DIR_FROM_ARG=false

# Flags
DRY_RUN=false
APPLY_FIXES=false
APPLY_HARDEN=false
CLEAR_CACHE=false

# --------------------------------------------------------
# 1. DYNAMIC WEB USER DETECTION
# --------------------------------------------------------
if id "www-data" >/dev/null 2>&1; then
    WWW_USER="www-data"; WWW_GROUP="www-data"
elif id "apache" >/dev/null 2>&1; then
    WWW_USER="apache"; WWW_GROUP="apache"
elif id "nginx" >/dev/null 2>&1; then
    WWW_USER="nginx"; WWW_GROUP="nginx"
else
    WWW_USER="www-data"; WWW_GROUP="www-data"
fi

# --------------------------------------------------------
# HELPER: run or simulate a command
# --------------------------------------------------------
run_cmd() {
    if [ "$DRY_RUN" = true ]; then
        echo "   [DRY-RUN] $*"
    else
        "$@"
    fi
}

# --------------------------------------------------------
# CORE FUNCTIONS
# --------------------------------------------------------

show_header() {
    echo "================================================================================"
    echo " Moodle Permissions Manager v${SCRIPT_RELEASE}"
    echo "================================================================================"
    echo " Web user   : ${WWW_USER}:${WWW_GROUP}"
    echo " Moodle dir : ${MOODLE_DIR} (${MOODLE_DIR_SOURCE})"
    echo " Data dir   : ${MOODLEDATA_DIR} (${MOODLEDATA_DIR_SOURCE})"
    if [ "$DRY_RUN" = true ]; then
        if [ "$APPLY_HARDEN" = true ]; then
            echo " Mode       : DRY-RUN of HARDEN (no changes applied)"
        else
            echo " Mode       : DRY-RUN of SEMI-HARDEN (no changes applied)"
        fi
    fi
    [ "$DRY_RUN"  = false ] && [ "$APPLY_FIXES" = true ] && echo " Mode       : SEMI-HARDEN (real changes, core code read-only)"
    [ "$DRY_RUN"  = false ] && [ "$APPLY_HARDEN" = true ] && echo " Mode       : HARDEN (real changes, read-only code tree)"
    echo "================================================================================"
}

show_help() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "  The permission model does not depend on the Moodle branch: 4.x and 5.x"
    echo "  are treated identically. If MOODLE_DIR and MOODLEDATA_DIR are set in the"
    echo "  script defaults, or readable from config.php, just run: $0 --semi-harden"
    echo ""
    echo "Options:"
    echo "  -h,  --help               Show this message"
    echo "  -d,  --dry-run            Simulate without applying. Combine with"
    echo "                            --semi-harden or --harden to choose the model;"
    echo "                            --semi-harden is simulated by default."
    echo "  -f,  --fix                Alias of --semi-harden (kept for compatibility)"
    echo "  -sh, --semi-harden        Apply the semi-hardened permission model (requires"
    echo "                            root): code tree owned by root and read-only for the"
    echo "                            web service, config.php 0640, moodledata 0750/0640,"
    echo "                            and group write only on the plugin type directories"
    echo "                            so the web UI can still install, update and"
    echo "                            uninstall plugins. No directory is pre-created."
    echo "  -hd, --harden             Apply the hardened permission model (requires root):"
    echo "                            code tree owned by root and NOT writable by the web"
    echo "                            service, config.php read-only for the web service,"
    echo "                            moodledata 0750/0640. Mutually exclusive with"
    echo "                            --semi-harden."
    echo "                            No directory is pre-created: Moodle creates its"
    echo "                            own subdirectories under dataroot on demand."
    echo "                            NOTE: --harden blocks exactly three web UI actions:"
    echo "                            install, update and uninstall a plugin. Everything"
    echo "                            else (language packs, themes, backups, H5P, uploads,"
    echo "                            caches) writes to moodledata and keeps working."
    echo "  -c,  --clear-cache        Purge the Moodle cache afterwards"
    echo "  -mp, --moodlepath PATH    Moodle path (default: /var/www/moodle)"
    echo "  -md, --moodledata PATH    moodledata path; if omitted it is read from"
    echo "                            \$CFG->dataroot in MOODLE_DIR/config.php"
    echo ""
    echo "SELinux note:"
    echo "  This script only changes owner and mode. It does NOT relabel SELinux"
    echo "  contexts. On RHEL/Alma/Rocky/Fedora with SELinux in enforcing mode, a"
    echo "  recursive chown/chmod can leave the tree with the wrong labels, so the"
    echo "  web service may be denied access even when owner and mode look correct."
    echo "  After --semi-harden or --harden, restore the contexts manually, e.g.:"
    echo "    restorecon -R -v /var/www/moodle /var/moodledata"
    echo "  If the labels were never set, define them first, e.g.:"
    echo "    semanage fcontext -a -t httpd_sys_content_t '/var/www/moodle(/.*)?'"
    echo "    semanage fcontext -a -t httpd_sys_rw_content_t '/var/moodledata(/.*)?'"
    echo "  Check the current state with: getenforce  and  ls -Z"
    echo ""
    echo "Path resolution:"
    echo "  Any path not supplied on the command line is read from config.php."
    echo "  -mp always wins over \$CFG->dirroot, -md always wins over \$CFG->dataroot."
    echo "  config.php is read with PHP when available (ABORT_AFTER_CONFIG, so Moodle"
    echo "  is not bootstrapped), otherwise with a literal text parse."
    echo ""
    echo "Exit codes:"
    echo "  0  Success"
    echo "  1  Invalid arguments"
    echo "  2  Root required for --semi-harden / --harden"
    echo "  3  Directory not found"
    echo "  5  chmod error"
    echo "  6  chown error"
    echo "  8  Cache purge error"
    echo "  9  config.php not found or not readable"
    echo " 10  \$CFG->dataroot not found in config.php"
}

# --------------------------------------------------------
# CONFIG.PHP PATH RESOLUTION
# Paths not supplied with -mp/-md are read from config.php.
# --------------------------------------------------------

# Reads a single $CFG value from config.php.
# Uses PHP when available (authoritative, ABORT_AFTER_CONFIG prevents the
# full Moodle bootstrap), otherwise falls back to a literal text parse.
get_cfg_value() {
    local name="$1"
    local config_file="$2"
    local value=""

    # PHP path. CLI_SCRIPT must be defined too: lib/setup.php checks it BEFORE
    # it honours ABORT_AFTER_CONFIG and dies otherwise, printing its complaint
    # on stdout, which would otherwise be captured as if it were the value.
    if command -v php >/dev/null 2>&1; then
        value=$(php -r "define('CLI_SCRIPT', true); define('ABORT_AFTER_CONFIG', true); require('$config_file'); if (isset(\$CFG->$name)) { echo \$CFG->$name; }" 2>/dev/null) || value=""
        # Pick the first line that looks like an absolute path: PHP notices,
        # deprecations and die() messages are printed on stdout too.
        value=$(printf '%s\n' "$value" | grep -m 1 '^/' || true)
        # Anything that is not a single absolute path is an error message,
        # a warning or a notice, never a usable value.
        case "$value" in
            /*) ;;
            *) value="" ;;
        esac
    fi

    # Literal text parse fallback.
    if [ -z "$value" ]; then
        value=$(sed -n "s/^[[:space:]]*\$CFG->$name[[:space:]]*=[[:space:]]*['\"]\([^'\"]*\)['\"][[:space:]]*;.*/\1/p" "$config_file" | tail -n 1)
        case "$value" in
            /*) ;;
            *) value="" ;;
        esac
    fi

    printf '%s' "$value"
}

resolve_paths_from_config() {
    # Nothing to read: both paths were supplied explicitly.
    if [ "$MOODLE_DIR_FROM_ARG" = true ] && [ "$MOODLEDATA_DIR_FROM_ARG" = true ]; then
        return
    fi

    local config_file="$MOODLE_DIR/config.php"

    if [ ! -f "$config_file" ]; then
        echo "❌ ERROR: config.php not found: $config_file"
        echo "   Supply the paths explicitly with -mp and -md, or point -mp at the"
        echo "   directory that contains config.php."
        exit $EXIT_CONFIG_NOT_FOUND
    fi
    if [ ! -r "$config_file" ]; then
        echo "❌ ERROR: config.php not readable: $config_file"
        echo "   It is normally root:${WWW_GROUP} 0640 — run the script as root."
        exit $EXIT_CONFIG_NOT_FOUND
    fi

    # $CFG->dirroot is usually derived at runtime, so it is adopted only when
    # config.php sets it explicitly and points at a real directory.
    if [ "$MOODLE_DIR_FROM_ARG" = false ]; then
        local dirroot
        dirroot=$(get_cfg_value "dirroot" "$config_file")
        if [ -n "$dirroot" ] && [ -d "$dirroot" ]; then
            MOODLE_DIR="$dirroot"
            MOODLE_DIR_SOURCE="config.php"
        fi
    fi

    if [ "$MOODLEDATA_DIR_FROM_ARG" = false ]; then
        local dataroot
        dataroot=$(get_cfg_value "dataroot" "$config_file")
        if [ -z "$dataroot" ]; then
            echo "❌ ERROR: could not read a usable \$CFG->dataroot from $config_file"
            echo "   Neither PHP nor the text parser returned an absolute path."
            echo "   Supply the moodledata path explicitly with -md."
            exit $EXIT_DATAROOT_NOT_FOUND
        fi
        if [ ! -d "$dataroot" ]; then
            echo "❌ ERROR: \$CFG->dataroot points at a non-existent directory:"
            echo "   $dataroot"
            echo "   Check config.php, or supply the path explicitly with -md."
            exit $EXIT_DATAROOT_NOT_FOUND
        fi
        MOODLEDATA_DIR="$dataroot"
        MOODLEDATA_DIR_SOURCE="config.php"
    fi
}

check_main_directories() {
    if [ ! -d "$MOODLE_DIR" ]; then
        echo "❌ ERROR: Moodle directory not found: $MOODLE_DIR"
        exit $EXIT_DIR_NOT_FOUND
    fi
    if [ ! -d "$MOODLEDATA_DIR" ]; then
        echo "❌ ERROR: moodledata directory not found: $MOODLEDATA_DIR"
        exit $EXIT_DIR_NOT_FOUND
    fi
}

purge_moodle_cache() {
    echo "🧹 Purging Moodle cache..."
    local purge_script="$MOODLE_DIR/admin/cli/purge_caches.php"
    if [ ! -f "$purge_script" ]; then
        echo "⚠️  purge_caches.php script not found. Cache not purged."
        exit $EXIT_CACHE_FAILED
    fi
    if [ "$DRY_RUN" = true ]; then
        echo "   [DRY-RUN] sudo -u $WWW_USER php $purge_script"
    else
        sudo -u "$WWW_USER" php "$purge_script" || {
            echo "❌ ERROR: purge_caches.php failed."
            exit $EXIT_CACHE_FAILED
        }
        echo "✅ Cache purged."
    fi
}

# --------------------------------------------------------
# PLUGIN TYPE DIRECTORIES
# Paths, relative to MOODLE_DIR, that the web UI must be able to write to
# in order to install, update and uninstall plugins. Everything outside
# this list stays read-only for the web service.
# Non-existent entries are skipped, so the list is safe across branches.
# --------------------------------------------------------
PLUGIN_TYPE_DIRS=(
    "mod" "blocks" "theme" "local" "filter" "enrol" "auth" "report"
    "admin/tool" "admin/report"
    "question/type" "question/behaviour" "question/format" "question/bank"
    "course/format" "availability/condition" "calendar/type"
    "message/output" "repository" "portfolio" "plagiarism" "webservice"
    "cache/stores" "cache/locks" "contenttype" "customfield/field"
    "dataformat" "files/converter" "gradingform"
    "grade/export" "grade/import" "grade/report"
    "h5p/h5plib" "lib/antivirus" "lib/editor"
    "media/player" "payment/gateway" "search/engine" "user/profile/field"
    "communication/provider" "ai/provider" "ai/placement"
    "mnet/service"
)

apply_semi_harden() {
    echo ""
    echo "🔐 Applying semi-hardened permissions..."
    check_main_directories

    # -- 1. Code tree owned by root, group = web service --
    echo "→ Ownership MOODLE_DIR   : root:${WWW_GROUP}"
    run_cmd chown -R "root:${WWW_GROUP}" "$MOODLE_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLE_DIR"
        exit $EXIT_CHOWN_FAILED
    }

    echo "→ MOODLE_DIR permissions : dirs 0755 / files 0644"
    run_cmd find "$MOODLE_DIR" -type d -exec chmod 0755 {} + || {
        echo "❌ ERROR: chmod 0755 failed on $MOODLE_DIR directories"
        exit $EXIT_CHMOD_FAILED
    }
    run_cmd find "$MOODLE_DIR" -type f -exec chmod 0644 {} + || {
        echo "❌ ERROR: chmod 0644 failed on $MOODLE_DIR files"
        exit $EXIT_CHMOD_FAILED
    }

    # -- 2. config.php: readable by the web service, writable only by root --
    if [ -f "$MOODLE_DIR/config.php" ]; then
        echo "→ config.php             : root:${WWW_GROUP} 0640"
        run_cmd chmod 0640 "$MOODLE_DIR/config.php" || {
            echo "❌ ERROR: chmod 0640 on config.php failed"
            exit $EXIT_CHMOD_FAILED
        }
    fi

    # -- 3. Plugin type directories: group-writable, setgid --
    # Recursive, because updating or uninstalling a plugin means deleting its
    # existing directory tree, not just writing into the parent.
    echo "→ Plugin type dirs       : dirs 2775 / files 0664 (group ${WWW_GROUP})"
    local found=0
    local skipped=0
    local ptdir
    for ptdir in "${PLUGIN_TYPE_DIRS[@]}"; do
        if [ -d "$MOODLE_DIR/$ptdir" ]; then
            run_cmd find "$MOODLE_DIR/$ptdir" -type d -exec chmod 2775 {} + || {
                echo "❌ ERROR: chmod 2775 failed on $MOODLE_DIR/$ptdir"
                exit $EXIT_CHMOD_FAILED
            }
            run_cmd find "$MOODLE_DIR/$ptdir" -type f -exec chmod 0664 {} + || {
                echo "❌ ERROR: chmod 0664 failed on $MOODLE_DIR/$ptdir"
                exit $EXIT_CHMOD_FAILED
            }
            found=$((found + 1))
            [ "$DRY_RUN" = false ] && echo "   + $ptdir"
        else
            skipped=$((skipped + 1))
        fi
    done
    echo "   ${found} plugin type dirs made writable, ${skipped} not present on this branch"

    # -- 4. moodledata: writable by the web service --
    echo "→ Ownership MOODLEDATA   : ${WWW_USER}:${WWW_GROUP}"
    run_cmd chown -R "${WWW_USER}:${WWW_GROUP}" "$MOODLEDATA_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLEDATA_DIR"
        exit $EXIT_CHOWN_FAILED
    }

    echo "→ MOODLEDATA permissions : dirs 0750 / files 0640"
    run_cmd find "$MOODLEDATA_DIR" -type d -exec chmod 0750 {} + || {
        echo "❌ ERROR: chmod 0750 failed on $MOODLEDATA_DIR directories"
        exit $EXIT_CHMOD_FAILED
    }
    run_cmd find "$MOODLEDATA_DIR" -type f -exec chmod 0640 {} + || {
        echo "❌ ERROR: chmod 0640 failed on $MOODLEDATA_DIR files"
        exit $EXIT_CHMOD_FAILED
    }

    # -- 5. .htaccess on moodledata (not web-writable) --
    if [ ! -f "$MOODLEDATA_DIR/.htaccess" ]; then
        echo "→ Creating .htaccess in moodledata"
        if [ "$DRY_RUN" = false ]; then
            echo "deny from all" > "$MOODLEDATA_DIR/.htaccess" || {
                echo "❌ ERROR: unable to create .htaccess"
                exit $EXIT_CHMOD_FAILED
            }
            chown "root:${WWW_GROUP}" "$MOODLEDATA_DIR/.htaccess"
            chmod 0640 "$MOODLEDATA_DIR/.htaccess"
        else
            echo "   [DRY-RUN] echo 'deny from all' > $MOODLEDATA_DIR/.htaccess"
        fi
    fi
    # Nginx warning (.htaccess has no effect)
    if echo "$WWW_USER" | grep -q "nginx"; then
        echo "⚠️  WARNING: web user 'nginx' detected. The .htaccess file has no effect"
        echo "   on Nginx. Make sure the moodledata directory is outside the webroot"
        echo "   or protected through a 'location' block in the Nginx configuration."
    fi

    # -- 6. No directory pre-creation --
    # Moodle creates its own subdirectories under dataroot on demand via
    # make_*_directory(), using the mode in $CFG->directorypermissions.

    echo ""
    if [ "$DRY_RUN" = true ]; then
        echo "✅ DRY-RUN complete: nothing was changed."
    else
        echo "✅ Semi-hardened permissions successfully applied."
    fi
    echo "ℹ️  Core code (lib/, install/, admin/cli, index.php, version.php,"
    echo "   config.php, vendor/) is now read-only for ${WWW_USER}."
    echo "   Plugin install, update and uninstall from the web UI still work."
    echo "ℹ️  SELinux contexts were NOT changed by this script. On a system with"
    echo "   SELinux enforcing, run manually:"
    echo "     restorecon -R -v \"$MOODLE_DIR\" \"$MOODLEDATA_DIR\""
    echo "   See -h for the full SELinux note."
}
apply_harden() {
    echo ""
    echo "🔒 Applying hardened permissions..."
    check_main_directories

    # -- 1. Code tree owned by root, never writable by the web service --
    echo "→ Ownership MOODLE_DIR   : root:root"
    run_cmd chown -R root:root "$MOODLE_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLE_DIR"
        exit $EXIT_CHOWN_FAILED
    }

    echo "→ MOODLE_DIR permissions : dirs 0755 / files 0644"
    run_cmd find "$MOODLE_DIR" -type d -exec chmod 0755 {} + || {
        echo "❌ ERROR: chmod 0755 failed on $MOODLE_DIR directories"
        exit $EXIT_CHMOD_FAILED
    }
    run_cmd find "$MOODLE_DIR" -type f -exec chmod 0644 {} + || {
        echo "❌ ERROR: chmod 0644 failed on $MOODLE_DIR files"
        exit $EXIT_CHMOD_FAILED
    }

    # -- 2. config.php: readable by the web service, writable only by root --
    if [ -f "$MOODLE_DIR/config.php" ]; then
        echo "→ config.php             : root:${WWW_GROUP} 0640"
        run_cmd chown "root:${WWW_GROUP}" "$MOODLE_DIR/config.php" || {
            echo "❌ ERROR: chown on config.php failed"
            exit $EXIT_CHOWN_FAILED
        }
        run_cmd chmod 0640 "$MOODLE_DIR/config.php" || {
            echo "❌ ERROR: chmod 0640 on config.php failed"
            exit $EXIT_CHMOD_FAILED
        }
    fi

    # -- 3. moodledata: the only tree writable by the web service --
    echo "→ Ownership MOODLEDATA   : ${WWW_USER}:${WWW_GROUP}"
    run_cmd chown -R "${WWW_USER}:${WWW_GROUP}" "$MOODLEDATA_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLEDATA_DIR"
        exit $EXIT_CHOWN_FAILED
    }

    echo "→ MOODLEDATA permissions : dirs 0750 / files 0640"
    run_cmd find "$MOODLEDATA_DIR" -type d -exec chmod 0750 {} + || {
        echo "❌ ERROR: chmod 0750 failed on $MOODLEDATA_DIR directories"
        exit $EXIT_CHMOD_FAILED
    }
    run_cmd find "$MOODLEDATA_DIR" -type f -exec chmod 0640 {} + || {
        echo "❌ ERROR: chmod 0640 failed on $MOODLEDATA_DIR files"
        exit $EXIT_CHMOD_FAILED
    }

    # -- 4. No .htaccess --
    # TurnKey writes no .htaccess: dataroot belongs outside the served tree,
    # which is the actual protection. See the closing note below.

    # -- 5. No directory pre-creation --
    # TurnKey does not pre-create anything under dataroot: Moodle creates its
    # own subdirectories on demand via make_*_directory(), using the mode in
    # $CFG->directorypermissions. Pre-creating them here would impose a mode
    # Moodle did not choose.

    echo ""
    if [ "$DRY_RUN" = true ]; then
        echo "✅ DRY-RUN complete: nothing was changed."
    else
        echo "✅ Hardened permissions successfully applied."
    fi
    echo "ℹ️  The code tree is now read-only for ${WWW_USER}: plugin install/update"
    echo "   from the web UI is disabled. Use the CLI as root instead."
    echo "ℹ️  No .htaccess is written. Make sure ${MOODLEDATA_DIR} is not reachable"
    echo "   from the web server (outside DocumentRoot, or denied in the vhost)."
    echo "ℹ️  SELinux contexts were NOT changed by this script. On a system with"
    echo "   SELinux enforcing, run manually:"
    echo "     restorecon -R -v \"$MOODLE_DIR\" \"$MOODLEDATA_DIR\""
    echo "   See -h for the full SELinux note."
}

# --------------------------------------------------------
# ARGUMENT PARSING
# --------------------------------------------------------
if [ $# -eq 0 ]; then
    show_header
    echo "❌ ERROR: No arguments provided."
    echo ""
    show_help
    exit $EXIT_INVALID_ARGS
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_header
            show_help
            exit $EXIT_OK
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -f|--fix|-sh|--semi-harden)
            APPLY_FIXES=true
            shift
            ;;
        -hd|--harden)
            APPLY_HARDEN=true
            shift
            ;;
        -c|--clear-cache)
            CLEAR_CACHE=true
            shift
            ;;
        -mp|--moodlepath)
            MOODLE_DIR="$2"
            MOODLE_DIR_FROM_ARG=true
            MOODLE_DIR_SOURCE="argument"
            shift 2
            ;;
        -md|--moodledata)
            MOODLEDATA_DIR="$2"
            MOODLEDATA_DIR_FROM_ARG=true
            MOODLEDATA_DIR_SOURCE="argument"
            shift 2
            ;;
        *)
            echo "❌ ERROR: Unknown argument: '$1'"
            echo "   Use -h to display the help."
            exit $EXIT_INVALID_ARGS
            ;;
    esac
done

# --------------------------------------------------------
# FINAL VALIDATION
# --------------------------------------------------------

# semi-harden and harden apply two different permission models
if [ "$APPLY_FIXES" = true ] && [ "$APPLY_HARDEN" = true ]; then
    echo "❌ ERROR: --semi-harden and --harden cannot be used together."
    exit $EXIT_INVALID_ARGS
fi

# Read from config.php any path not supplied with -mp/-md
resolve_paths_from_config

# --------------------------------------------------------
# EXECUTION
# --------------------------------------------------------
show_header

if [ "$DRY_RUN" = true ]; then
    # run_cmd prints without executing; --semi-harden is simulated by default
    if [ "$APPLY_HARDEN" = true ]; then
        apply_harden
    else
        apply_semi_harden
    fi

elif [ "$APPLY_FIXES" = true ]; then
    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ ERROR: --semi-harden requires root privileges."
        exit $EXIT_NOT_ROOT
    fi
    apply_semi_harden
    if [ "$CLEAR_CACHE" = true ]; then
        purge_moodle_cache
    fi

elif [ "$APPLY_HARDEN" = true ]; then
    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ ERROR: --harden requires root privileges."
        exit $EXIT_NOT_ROOT
    fi
    apply_harden
    if [ "$CLEAR_CACHE" = true ]; then
        purge_moodle_cache
    fi

else
    echo "ℹ️  No action specified."
    echo "   Use --semi-harden or --harden to apply the changes, or --dry-run to simulate."
fi

exit $EXIT_OK
